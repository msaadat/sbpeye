# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv
.env.local
.codex/
.claude/

# Frontend
frontend/node_modules/
frontend/dist/
src/sbpeye/static/spa/

# Local vector index
/chroma_db/

# Application file storage. One tree, split by how much it costs to lose the contents:
# files/laws/ is the archive (irreplaceable), files/circulars/ is re-fetchable, and
# files/cache/ is disposable. See src/sbpeye/env.py.
/files/
# Third-party embedding model weights, not application data.
/models/


# Local analysis and rendered QA artifacts
/tmp/

# LLM trace recorder — diagnostics, not corpus data (sbpeye.db itself is tracked)
/sbpeye_debug.db
# Runtime state — workspaces, chat, settings. Created per deployment, never shipped;
# the corpus in sbpeye.db is the only database that belongs in git.
/sbpeye_app.db
*.db.backup-*

# WAL sidecars. The databases run in WAL mode (see `database.py`) so a sync can write
# while users read, which means an open database has uncheckpointed commits sitting in
# `-wal` rather than in the file git tracks. Committing or uploading `sbpeye.db` while
# the app holds it open therefore ships a corpus missing its most recent writes: stop
# the app, or run `PRAGMA wal_checkpoint(TRUNCATE)`, before either.
*.db-wal
*.db-shm

# Benchmark runs — captured answers and scores. The methodology in benchmarks/ is
# tracked; results are per-run, per-model evidence and stay local.
/benchmarks/results/
