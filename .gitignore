# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv
.env.local
.codex/
.claude/

# Frontend
frontend/node_modules/
frontend/dist/
src/sbpeye/static/spa/

# Local vector index
/chroma_db/

# Scraper caches
/cache/
/attachments/

# Local analysis and rendered QA artifacts
/tmp/

# LLM trace recorder — diagnostics, not corpus data (sbpeye.db itself is tracked)
/sbpeye_debug.db
# Runtime state — workspaces, chat, settings. Created per deployment, never shipped;
# the corpus in sbpeye.db is the only database that belongs in git.
/sbpeye_app.db
*.db.backup-*

# Benchmark runs — captured answers and scores. The methodology in benchmarks/ is
# tracked; results are per-run, per-model evidence and stay local.
/benchmarks/results/
